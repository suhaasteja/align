# systemd unit for Linux (Raspberry Pi, NAS, any always-on Linux box).
#
#   sudo cp deploy/tv-remote.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tv-remote
#
# Adjust User and WorkingDirectory to match where you cloned it.

[Unit]
Description=TV Remote
Documentation=https://github.com/suhaasteja/tv-remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tv-remote
Environment=PORT=8477
# Confirm this path with `which node` — nvm and Homebrew installs differ.
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

# It only needs to talk to the LAN and write its own config.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/.tv-remote

[Install]
WantedBy=multi-user.target
